# ============================================================================
# FabSoft Redes Sociales (Pipeline Agéntico HITL) - Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://redes.fabsoft.app

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=fabsoft
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=fabsoft_redes
# In Docker Compose / Coolify, host is "db". For local dev, use "localhost".
DATABASE_URL=postgresql://fabsoft:change_me_strong_password@db:5432/fabsoft_redes

# --- AI Provider (OpenRouter recomendado | Gemini fallback) -----------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Google Gemini (Opcional si usas AI_PROVIDER=gemini) --------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# --- Cloudflare R2 (S3-compatible Object Storage) ---------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=fabsoft-redes-media
R2_PUBLIC_URL=https://media.fabsoft.app

# --- Telegram Bot (HITL Approval Group) -------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=change_me_random_webhook_secret

# --- Instagram Meta Graph API -----------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_GRAPH_API_VERSION=v22.0

# --- Scheduler / Cron -------------------------------------------------------
CRON_ENABLED=false
CRON_SCHEDULE=0 10 * * 1,3,5
CRON_TIMEZONE=America/Bogota
RECORDING_CRON_ENABLED=true
RECORDING_CRON_SCHEDULE=0 9 * * 1,4
